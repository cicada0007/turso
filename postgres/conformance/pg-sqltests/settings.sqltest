# SET, SHOW, RESET and DISCARD ALL of configuration parameters through the
# PostgreSQL frontend.

@database :memory:

test set-and-show-custom-parameter {
    SET app.user_id = '42';
    SHOW app.user_id;
    SET app.user_id TO 43;
    SHOW app.user_id;
    SET app.user_id = some_name;
    SHOW app.user_id;
    SELECT current_setting('app.user_id');
}
expect {
    42
    43
    some_name
    some_name
}

test set-custom-parameter-name-is-not-case-sensitive {
    SET "App.Mixed_Case" = 'v';
    SHOW app.mixed_case;
}
expect {
    v
}

test set-custom-parameter-with-two-values-errors {
    SET app.list = a, b;
}
@sqlstate 22023
expect error {
    SET app\.list takes only one argument
}

test show-custom-parameter-set-by-set-config {
    SELECT set_config('app.from_function', 'v', false);
    SHOW app.from_function;
}
expect {
    v
    v
}

test show-undefined-custom-parameter-errors {
    SHOW app.never_set;
}
@sqlstate 42704
expect error {
    unrecognized configuration parameter "app\.never_set"
}

test set-local-custom-parameter-ends-at-commit {
    SET app.mode = 'session';
    BEGIN;
    SET LOCAL app.mode = 'local';
    SHOW app.mode;
    COMMIT;
    SHOW app.mode;
}
expect {
    local
    session
}

test set-custom-parameter-is-undone-by-rollback {
    SET app.mode = 'before';
    BEGIN;
    SET app.mode = 'in transaction';
    ROLLBACK;
    SHOW app.mode;
}
expect {
    before
}

test reset-custom-parameter {
    SET app.mode = 'v';
    RESET app.mode;
    SELECT quote_literal(current_setting('app.mode'));
    SET app.mode = 'w';
    SET app.mode TO DEFAULT;
    SELECT quote_literal(current_setting('app.mode'));
    SET app.mode = 'x';
    SET app.mode = DEFAULT;
    SELECT quote_literal(current_setting('app.mode'));
}
expect {
    ''
    ''
    ''
}

test reset-defines-a-custom-parameter-that-was-never-set {
    RESET app.never_set;
    SELECT quote_literal(current_setting('app.never_set'));
}
expect {
    ''
}

test set-from-current-keeps-the-current-value {
    SET app.v = 'q';
    BEGIN;
    SET LOCAL app.v FROM CURRENT;
    SHOW app.v;
    COMMIT;
    SHOW app.v;
    SET search_path = a, "B c";
    SET search_path FROM CURRENT;
    SHOW search_path;
}
expect {
    q
    q
    a, "B c"
}

test set-from-current-makes-a-local-value-the-session-value {
    SET app.v = 'session';
    BEGIN;
    SET LOCAL app.v = 'local';
    SET app.v FROM CURRENT;
    COMMIT;
    SHOW app.v;
}
expect {
    local
}

test set-from-current-of-an-undefined-custom-parameter-errors {
    SET app.never_set FROM CURRENT;
}
@sqlstate 42704
expect error {
    unrecognized configuration parameter "app\.never_set"
}

test reset-search-path {
    SET search_path = other_schema;
    RESET search_path;
    SHOW search_path;
    SET search_path = other_schema;
    SET search_path TO DEFAULT;
    SHOW search_path;
}
expect {
    "$user", public
    "$user", public
}

test reset-local-search-path-ends-at-commit {
    SET search_path = other_schema;
    BEGIN;
    SET LOCAL search_path TO DEFAULT;
    SHOW search_path;
    COMMIT;
    SHOW search_path;
}
expect {
    "$user", public
    other_schema
}

test reset-all {
    SET app.a = 'a';
    SET search_path = other_schema;
    RESET ALL;
    SELECT quote_literal(current_setting('app.a'));
    SHOW search_path;
}
expect {
    ''
    "$user", public
}

test reset-all-also-resets-local-values {
    BEGIN;
    SET LOCAL app.a = 'local';
    RESET ALL;
    SELECT quote_literal(current_setting('app.a'));
    COMMIT;
}
expect {
    ''
}

test reset-all-is-undone-by-rollback {
    SET app.a = 'a';
    SET search_path = other_schema;
    BEGIN;
    RESET ALL;
    ROLLBACK;
    SHOW app.a;
    SHOW search_path;
}
expect {
    a
    other_schema
}

test discard-all-resets-parameters {
    SET app.a = 'a';
    SET search_path = other_schema;
    DISCARD ALL;
    SELECT quote_literal(current_setting('app.a'));
    SHOW search_path;
}
expect {
    ''
    "$user", public
}

test discard-all-forgets-currval {
    CREATE SEQUENCE discard_seq;
    SELECT nextval('discard_seq');
    DISCARD ALL;
    SELECT currval('discard_seq');
}
expect error {
    currval of sequence "discard_seq" is not yet defined in this session
}

test discard-all-inside-a-transaction-errors {
    BEGIN;
    DISCARD ALL;
}
@sqlstate 25001
expect error {
    DISCARD ALL cannot run inside a transaction block
}

test builtin-datestyle-apis-agree {
    SET DATESTYLE = ISO;
    SHOW DateStyle;
    SELECT pg_catalog.set_config('datestyle', 'iso', true);
    SELECT current_setting('DATESTYLE');
    SET datestyle = ISO, MDY;
    SHOW datestyle;
    RESET datestyle;
    SELECT set_config('datestyle', NULL, false);
    SET datestyle FROM CURRENT;
    SHOW datestyle;
}
expect {
    ISO, MDY
    ISO, MDY
    ISO, MDY
    ISO, MDY
    ISO, MDY
    ISO, MDY
}

test builtin-application-name-transaction-scope {
    SELECT CASE WHEN set_config('app.default_name', current_setting('application_name'), false) IS NOT NULL THEN 'yes' ELSE 'no' END;
    SET application_name = 'session';
    SELECT set_config('application_name', 'probe', true);
    SHOW application_name;
    BEGIN;
    SET LOCAL application_name = 'local';
    SHOW application_name;
    COMMIT;
    SHOW application_name;
    BEGIN;
    SET application_name = 'rolled back';
    ROLLBACK;
    SHOW application_name;
    SELECT CASE WHEN set_config('application_name', NULL, false) = current_setting('app.default_name') THEN 'yes' ELSE 'no' END;
    SELECT CASE WHEN current_setting('application_name') = current_setting('app.default_name') THEN 'yes' ELSE 'no' END;
}
expect {
    yes
    probe
    session
    local
    session
    session
    yes
    yes
}

test builtin-pgdump-setup-functions {
    SELECT set_config('client_encoding', 'unicode', true);
    SELECT set_config('standard_conforming_strings', 'true', true);
    SELECT set_config('statement_timeout', '0', true);
    SELECT set_config('lock_timeout', '0', true);
    SELECT set_config('idle_in_transaction_session_timeout', '0', true);
    SELECT set_config('row_security', 'false', true);
    SELECT set_config('IntervalStyle', 'postgres', true);
    SELECT set_config('extra_float_digits', '1', true);
    SELECT set_config('check_function_bodies', 'false', true);
    SELECT set_config('client_min_messages', 'warning', true);
    SELECT set_config('default_table_access_method', 'heap', true);
    SELECT set_config('xmloption', 'content', true);
}
expect {
    UTF8
    on
    0
    0
    0
    off
    postgres
    1
    off
    warning
    heap
    content
}

# tursopg refuses every value it does not support with one error, including
# values that PostgreSQL itself rejects as invalid.
test builtin-invalid-datestyle-function {
    SELECT set_config('datestyle', 'bogus', true);
}
@sqlstate 22023
expect error {
    invalid value for parameter "DateStyle"
}
@sqlstate 0A000
expect @tursopg error {
    parameter "DateStyle" does not support value "bogus"; supported: "ISO, MDY"
}

test builtin-invalid-datestyle-set {
    SET datestyle = bogus;
}
@sqlstate 22023
expect error {
    invalid value for parameter "DateStyle"
}
@sqlstate 0A000
expect @tursopg error {
    parameter "DateStyle" does not support value "bogus"; supported: "ISO, MDY"
}

# tursopg works in UTC with ISO dates, PostgreSQL intervals and UTF8, so it
# refuses the values that would change those in PostgreSQL. One test for each
# kind of check.
test set-unsupported-timezone {
    SET TimeZone = 'Europe/Helsinki';
    SHOW TimeZone;
}
expect {
    Europe/Helsinki
}
@sqlstate 0A000
expect @tursopg error {
    parameter "TimeZone" does not support value "Europe/Helsinki"; supported: "UTC", "Etc/UTC"
}

test set-unsupported-intervalstyle {
    SET IntervalStyle = iso_8601;
    SHOW IntervalStyle;
}
expect {
    iso_8601
}
@sqlstate 0A000
expect @tursopg error {
    parameter "IntervalStyle" does not support value "iso_8601"; supported: "postgres"
}

test set-unsupported-statement-timeout {
    SET statement_timeout = '5s';
    SHOW statement_timeout;
}
expect {
    5s
}
@sqlstate 0A000
expect @tursopg error {
    parameter "statement_timeout" does not support value "5s"; supported: "0"
}

test set-unsupported-standard-conforming-strings {
    SET standard_conforming_strings = off;
    SHOW standard_conforming_strings;
}
expect {
    off
}
@sqlstate 0A000
expect @tursopg error {
    parameter "standard_conforming_strings" does not support value "off"; supported: "on"
}

test set-unsupported-extra-float-digits {
    SET extra_float_digits = 0;
    SHOW extra_float_digits;
}
expect {
    0
}
@sqlstate 0A000
expect @tursopg error {
    parameter "extra_float_digits" does not support value "0"; supported: "1", "2", "3"
}

test set-unsupported-client-encoding {
    SET client_encoding = LATIN1;
    SHOW client_encoding;
}
expect {
    LATIN1
}
@sqlstate 0A000
expect @tursopg error {
    parameter "client_encoding" does not support value "LATIN1"; supported: "UTF8"
}

test set-config-client-encoding-name-longer-than-63-bytes {
    SELECT set_config('client_encoding', 'u' || repeat('-', 70) || 'tf8', false);
}
@sqlstate 22023
expect error {
    invalid value for parameter "client_encoding"
}
@sqlstate 0A000
expect @tursopg error {
    parameter "client_encoding" does not support value "u-{70}tf8"; supported: "UTF8"
}

test set-accepts-spellings-of-supported-values {
    SET TimeZone = 'utc';
    SHOW TimeZone;
    SET DateStyle = US, iso;
    SHOW DateStyle;
    SET client_encoding = 'unicode';
    SHOW client_encoding;
    SET extra_float_digits = 3;
    SHOW extra_float_digits;
}
expect {
    UTC
    ISO, MDY
    UTF8
    3
}

# PostgreSQL rewrites other bytes of application_name as \xNN escapes and cuts
# it to 63 bytes. tursopg refuses such values instead of changing them.
test set-application-name-longer-than-63-bytes {
    SET application_name = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
    SELECT length(current_setting('application_name'));
}
expect {
    63
}
@sqlstate 0A000
expect @tursopg error {
    parameter "application_name" does not support value "a{64}"; supported: printable ASCII text of at most 63 bytes
}

test set-application-name-with-non-ascii-text {
    SET application_name = 'café';
    SELECT length(current_setting('application_name'));
}
expect {
    11
}
@sqlstate 0A000
expect @tursopg error {
    parameter "application_name" does not support value "café"; supported: printable ASCII text of at most 63 bytes
}

test set-unknown-parameter-errors {
    SET no_such_parameter = 1;
}
@sqlstate 42704
expect error {
    unrecognized configuration parameter "no_such_parameter"
}
@sqlstate 0A000
expect @tursopg error {
    parameter "no_such_parameter" is not supported
}

test builtin-application-name-local-reset-and-from-current {
    SELECT CASE WHEN set_config('app.default_name', current_setting('application_name'), false) IS NOT NULL THEN 'yes' ELSE 'no' END;
    SET application_name = 'session';
    BEGIN;
    SET LOCAL application_name TO DEFAULT;
    SELECT CASE WHEN current_setting('application_name') = current_setting('app.default_name') THEN 'yes' ELSE 'no' END;
    COMMIT;
    SHOW application_name;
    BEGIN;
    SET LOCAL application_name = 'local';
    SET application_name FROM CURRENT;
    COMMIT;
    SHOW application_name;
    SELECT current_setting('datestyle', true);
    SELECT CASE WHEN current_setting('datestyle', NULL) IS NULL THEN 'yes' ELSE 'no' END;
    SELECT CASE WHEN current_setting(NULL) IS NULL THEN 'yes' ELSE 'no' END;
}
expect {
    yes
    yes
    session
    local
    ISO, MDY
    yes
    yes
}
